menu "Game Boy"
    config GB_EPD_GEN2
        bool "Panel is the GEN2 variant (GEDY075-D2)"
        default n
    config GB_FULL_EVERY
        int "Full refresh after this many partial refreshes"
        default 20
        range 1 1000
    config GB_START_HOLD_MS
        int "Hold the button this long for Start"
        default 1000
    config GB_NO_PANEL
        bool "No panel attached (QEMU, tools/qemu.sh): skip the panel driver, a refresh takes 1 s"
        default n
endmenu
