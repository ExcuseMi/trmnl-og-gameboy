# ESP-IDF v5.5.1, TRMNL OG (ESP32-C3, 4 MB flash). Board values after tiny-paper boards/trmnl_og/sdkconfig.defaults (9fcff4a7).
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_RTC_CLK_SRC_INT_RC=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# Speed: the emulator is the bottleneck. The emulator task may starve the idle task, so no idle watchdog.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# BLE gamepad: NimBLE host, central + observer only, one connection, bonds in NVS.
# First hardware run (Xbox pad, 2026-10-03): the receive pool ran empty right after the link ("ACL buf alloc failed",
# "MBUF alloc stuck"), the GATT discovery then timed out. So: host flow control (the controller holds the pad back
# while the host is busy, e.g. with the pairing maths), a larger receive pool, and the GATT server and default
# msys pool back (the pad queries the central too). Heap had 108 KB free, so there is room.
CONFIG_BT_NIMBLE_HS_FLOW_CTRL=y
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=48
# Seen on hardware: after a link that was lost, the scan ran but no advert reached the host any more (count stood
# still, a scan restart did not help). The controller's advert flow control drops reports once the host is behind;
# without it the reports just come.
CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_SUPP=n
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=2
CONFIG_BT_NIMBLE_MAX_CCCDS=2
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_CTRL_BLE_MAX_ACT=3
