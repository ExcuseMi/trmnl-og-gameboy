# ESP-IDF v5.5.1, TRMNL OG (ESP32-C3, 4 MB flash). Board values after tiny-paper boards/trmnl_og/sdkconfig.defaults (9fcff4a7).
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_RTC_CLK_SRC_INT_RC=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# Speed: the emulator is the bottleneck. The emulator task may starve the idle task, so no idle watchdog.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# BLE gamepad: NimBLE host as central + observer, bonds in NVS. Otherwise ESP-IDF's defaults on purpose: the trimmed
# settings of the first version (max 3 controller activities, 1 connection, no GATT server) and the host flow control
# tried later went with links that died after 2 to 3 s (disconnect 520), a scan that heard nothing afterwards and a
# controller assert on a reset. Heap has about 100 KB free, so the defaults fit.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
# The host task runs the pairing maths and the GATT callbacks: twice the default stack.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
